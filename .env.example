# --- Firebase (client) ---
# These are read by firebase/config.ts. They are public by design (served to
# the browser), but should still be restricted by HTTP referrer in GCP Console.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=be-right-back-b47be.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=be-right-back-b47be
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=be-right-back-b47be.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase (server) ---
# Read by lib/firestore.ts and lib/auth/firebase.server.ts. Same API key as
# NEXT_PUBLIC_FIREBASE_API_KEY (the browser key).
FIREBASE_API_KEY=

# --- LLM provider ---
# "lm-studio" (default) or "ollama"
LLM_PROVIDER=lm-studio

# LM Studio options
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=qwen3.5:9b
# LM_STUDIO_API_KEY=

# Ollama options (used when LLM_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Rate limiting (optional; defaults are sensible for a personal project) ---
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_BURST=5
# RATE_LIMIT_CONCURRENCY_PER_UID=2
# RATE_LIMIT_CONCURRENCY_GLOBAL=10
