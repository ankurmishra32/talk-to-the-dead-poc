rules_version = '2';

// Firestore security rules for talk-to-the-dead-poc.
//
// Before these rules, the database was effectively world-readable and
// world-writable: anyone who knew the project ID (visible in
// firebase/config.ts) could call the REST API or open a browser
// session and read every persona and memory in the database.
//
// These rules enforce the same ownership boundary the server-side
// getPersona() check in lib/firestore.ts enforces for the chat route,
// but at the DB level. The client SDK (used by components/
// PersonaSelection.tsx and components/MemoryInput.tsx) will now be
// stopped by the rules if it tries to read or write another user's
// documents.
//
// The client SDK and /api/chat's REST requests both send a Firebase ID
// token, so these rules are the primary ownership boundary for every
// Firestore read and write.
//
// To deploy:
//   npm install -g firebase-tools   # if not installed
//   firebase login
//   firebase use --add              # link this project
//   firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // Personas: a user can create, read, and (in principle) update
    // and delete their own. The client UI only creates today; update
    // and delete are allowed so the user is not locked out of
    // future-self changes. The create-time check on userId prevents
    // a client from creating a document owned by someone else.
    match /personas/{personaId} {
      allow read: if isSignedIn()
                   && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;

      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // Memories: same ownership boundary. The client only creates;
    // update/delete are allowed for future use and for owner-driven
    // pruning.
    match /memories/{memoryId} {
      allow read: if isSignedIn()
                   && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId;

      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // Conversation history. Each turn is a document under
    // /conversations/{personaId}/messages/{msgId}. Same ownership
    // boundary as personas and memories.
    //
    // Ownership is the `userId` field on every message (the same field
    // personas and memories use), set at write time by the client (user
    // turns) and by /api/chat (assistant replies, written with the user's
    // own ID token). We deliberately do NOT call get() against the parent
    // persona document here: Firestore caps rule-evaluator get() calls at
    // 10 per query, and this rule runs per matched document on a
    // subcollection query, so a get() would make larger reads fail. The
    // `personaId` is denormalized so create/update can assert the message
    // is written under the intended persona path. The server route also
    // re-checks persona ownership before saving an assistant reply.
    //
    // Queries must filter on userId == auth.uid (Chat.tsx and
    // lib/account.ts do) so Firestore can prove the read rule holds.
    match /conversations/{personaId}/messages/{msgId} {
      allow read, delete: if isSignedIn()
                           && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.personaId == personaId;

      // Owner can't change (both sides must be the requester) and the
      // message can't be moved to another persona.
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.personaId == personaId
                    && request.resource.data.personaId == resource.data.personaId;
    }

    // User profiles: users/{uid}, written at signup step 2 (lib/users.ts)
    // and removed on account deletion (lib/account.ts). The document id
    // is the owner's uid, so ownership is the path itself. The stored
    // `uid` field must match too, so a profile can't claim another user.
    match /users/{uid} {
      allow read, delete: if isSignedIn() && request.auth.uid == uid;

      allow create, update: if isSignedIn()
                            && request.auth.uid == uid
                            && request.resource.data.uid == uid;
    }

    // Default-deny anything not explicitly allowed above. Adding a
    // new collection requires an explicit rule.
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}
